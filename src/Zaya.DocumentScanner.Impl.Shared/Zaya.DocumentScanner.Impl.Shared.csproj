<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>13</LangVersion>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Title>Zaya Document Scanner</Title>
    <Description>Scans documents and exports them to PDF/DOCX — shared UI and logic.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Authors>SHTrassEr</Authors>
    <RepositoryUrl>https://github.com/shtrasser-dev/Zaya.DocumentScanner</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.10" />
    <PackageReference Include="Zaya.Logging" Version="$(ZayaLoggingVersion)" />
    <PackageReference Include="Zaya.Logging.Impl" Version="$(ZayaLoggingVersion)" />
    <PackageReference Include="Zaya.Logging.Impl.Microsoft" Version="$(ZayaLoggingVersion)" />
    <PackageReference Include="Zaya.OCR" Version="$(ZayaOcrVersion)" />
    <PackageReference Include="Zaya.OCR.Impl.OneOcr" Version="$(ZayaOcrVersion).0" />
    <PackageReference Include="Zaya.OCR.Impl.ProximityTextLayout" Version="$(ZayaOcrVersion).0" />
    <PackageReference Include="Zaya.Primitives" Version="$(ZayaPrimitivesVersion)" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.10" />
    <PackageReference Include="Svg.Controls.Skia.Avalonia" Version="12.0.0.13" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!-- Renders SettingDescriptor lists as Avalonia controls (used by the settings panel). -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\Zaya.UI\src\Zaya.UI.Impl\Zaya.UI.Impl.csproj" />
  </ItemGroup>

</Project>
