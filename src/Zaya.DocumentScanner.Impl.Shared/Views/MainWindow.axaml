<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Zaya.DocumentScanner.Impl.Shared.Views"
        xmlns:models="clr-namespace:Zaya.DocumentScanner.Impl.Shared.Models"
        xmlns:ctrl="clr-namespace:Zaya.DocumentScanner.Impl.Shared.Views.Controls"
        xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
        xmlns:vm="clr-namespace:Zaya.DocumentScanner.Impl.Shared.ViewModels"
        x:Class="Zaya.DocumentScanner.Impl.Shared.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Zaya Document Scanner"
        Width="720" MinWidth="600"
        Height="240" MinHeight="0"
        SizeToContent="Height"
        WindowStartupLocation="Manual">
    <Window.Styles>
        <Style Selector="Button.main-nav">
            <Setter Property="MinWidth" Value="{x:Static ctrl:MainLayout.NavWidth}" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.main-nav.start">
            <Setter Property="Background" Value="#2E7D32" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button.main-nav.start:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1B5E20" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.main-nav.start:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#145214" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Window.Styles>

    <Panel Name="Root">
        <!-- Canvas reports 0 desired size so the decorative logo does not inflate window height. -->
        <Canvas ClipToBounds="True"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                IsHitTestVisible="False">
            <Viewbox Stretch="Uniform"
                     Width="{Binding #Root.Bounds.Width}"
                     Height="{Binding #Root.Bounds.Height}"
                     Margin="56"
                     Opacity="{DynamicResource MainWindowLogoOpacity}">
                <svg:Svg Width="1254" Height="1254"
                         Path="avares://Zaya.DocumentScanner.Impl.Shared/Assets/logo.svg"
                         Css="{DynamicResource MainWindowLogoCss}" />
            </Viewbox>
        </Canvas>

        <Grid Name="MainLayoutGrid" Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" MinHeight="0" />
            </Grid.RowDefinitions>

            <!-- Left nav + file table -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
                <StackPanel Grid.Column="0"
                            Width="{x:Static ctrl:MainLayout.NavWidth}"
                            Spacing="4"
                            VerticalAlignment="Top">
                    <Button Classes="main-nav"
                            Name="AddFilesButton"
                            Content="Добавить файлы..."
                            Click="OnAddFilesClick" />
                    <Button Classes="main-nav start"
                            Name="StartButton"
                            Content="Начать распознавание"
                            IsEnabled="False"
                            Click="OnStartClick" />
                    <Button Classes="main-nav"
                            Name="ClearFilesButton"
                            Content="Очистить"
                            IsEnabled="False"
                            Click="OnClearFilesClick" />
                </StackPanel>

                <DockPanel Grid.Column="1" Margin="24,0,0,0">
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="24,32,44,*,40" Margin="0,0,0,4">
                        <TextBlock Grid.Column="1" Text="№" FontWeight="Bold" Margin="4,4" />
                        <TextBlock Grid.Column="3" Text="Файл" FontWeight="Bold" Margin="8,4" />
                    </Grid>
                    <Border DockPanel.Dock="Top" Height="1" Background="#CCCCCC" Margin="0,0,0,4" />

                    <!-- Transparent: the default theme's opaque ListBox chrome would otherwise
                         blank out the decorative logo wherever the table sits on top of it.
                         Fixed to 4 rows - settings unfold below whatever the table doesn't show. -->
                    <ListBox Name="FilesList" Height="176" Background="Transparent" VerticalAlignment="Top">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="models:ScanFileEntry">
                                <Grid ColumnDefinitions="24,32,44,*,40" Background="Transparent" DragDrop.AllowDrop="True">
                                    <TextBlock Grid.Column="0" Text="⠿" VerticalAlignment="Center" HorizontalAlignment="Center"
                                               Cursor="SizeAll" Opacity="0.5" PointerPressed="OnDragHandlePointerPressed" />
                                    <TextBlock Grid.Column="1" Text="{Binding Number}" VerticalAlignment="Center" Margin="4" />
                                    <Border Grid.Column="2" Width="36" Height="36" Margin="4" ClipToBounds="True"
                                            CornerRadius="2" Background="#E8E8E8">
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform">
                                            <ToolTip.Tip>
                                                <Border Background="White" BorderBrush="#AAAAAA" BorderThickness="1" Padding="2">
                                                    <Image Source="{Binding Thumbnail}" MaxWidth="480" MaxHeight="480" Stretch="Uniform" />
                                                </Border>
                                            </ToolTip.Tip>
                                        </Image>
                                    </Border>
                                    <TextBlock Grid.Column="3" Text="{Binding FileName}" VerticalAlignment="Center" Margin="8,4" />
                                    <Button Grid.Column="4" Content="✕" Tag="{Binding}" Click="OnRemoveFileRowClick" Padding="6,2" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Grid>

            <!-- Settings toggle (nav-column width) + status, below the main content -->
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="0,8,0,0">
                <Button Grid.Column="0"
                        Classes="main-nav"
                        Width="{x:Static ctrl:MainLayout.NavWidth}"
                        Name="SettingsButton"
                        Content="{Binding SettingsToggleText}"
                        Command="{Binding ToggleSettingsCommand}" />
                <TextBlock Grid.Column="1"
                           Name="StatusText"
                           Margin="24,0,0,0"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           FontSize="12" />
            </Grid>

            <!-- Inline settings - no background of its own (SettingsPanel), so the logo still
                 shows through here too; just a top divider line, same as ScreenTranslator. -->
            <Border Grid.Row="2"
                    IsVisible="{Binding IsSettingsOpen}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                    BorderThickness="0,1,0,0"
                    Margin="0,8,0,0">
                <views:SettingsPanel DataContext="{Binding Settings}" />
            </Border>
        </Grid>
    </Panel>
</Window>
