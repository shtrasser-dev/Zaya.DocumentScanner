<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Zaya.DocumentScanner.Impl.Shared.Views"
        xmlns:models="clr-namespace:Zaya.DocumentScanner.Impl.Shared.Models"
        x:Class="Zaya.DocumentScanner.Impl.Shared.Views.MainWindow"
        Title="Zaya Document Scanner"
        Width="640" Height="520" MinHeight="0"
        SizeToContent="Height">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="12,12,12,8">
            <Button Name="AddFilesButton" Content="Добавить файлы..." Click="OnAddFilesClick" />
            <Button Name="SettingsButton" Content="Настройки" Click="OnSettingsClick" />
            <TextBlock Name="StatusText" VerticalAlignment="Center" />
        </StackPanel>

        <!-- SizeToContent="Height" above means this panel appearing/disappearing grows or shrinks
             the window itself, instead of squeezing the file table's fixed height like a DockPanel
             "fill" region would - same approach ScreenTranslator's MainWindow uses. -->
        <views:SettingsPanel Name="SettingsPanelControl" DockPanel.Dock="Bottom" IsVisible="False" />

        <Button Name="StartButton"
                DockPanel.Dock="Bottom"
                Content="Начать распознавание"
                Margin="12,8,12,12"
                HorizontalAlignment="Right"
                IsEnabled="False"
                Click="OnStartClick" />

        <Grid DockPanel.Dock="Top" ColumnDefinitions="24,32,*,40" Margin="12,0,12,4">
            <TextBlock Grid.Column="1" Text="№" FontWeight="Bold" Margin="4,4" />
            <TextBlock Grid.Column="2" Text="Файл" FontWeight="Bold" Margin="8,4" />
        </Grid>
        <Border DockPanel.Dock="Top" Height="1" Background="#CCCCCC" Margin="12,0,12,4" />

        <ListBox Name="FilesList" Height="320" Margin="12,0,12,12">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="models:ScanFileEntry">
                    <Grid ColumnDefinitions="24,32,*,40" Background="Transparent" DragDrop.AllowDrop="True">
                        <TextBlock Grid.Column="0" Text="⠿" VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Cursor="SizeAll" Opacity="0.5" PointerPressed="OnDragHandlePointerPressed" />
                        <TextBlock Grid.Column="1" Text="{Binding Number}" VerticalAlignment="Center" Margin="4" />
                        <TextBlock Grid.Column="2" Text="{Binding FileName}" VerticalAlignment="Center" Margin="8,4" />
                        <Button Grid.Column="3" Content="✕" Tag="{Binding}" Click="OnRemoveFileRowClick" Padding="6,2" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
