<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Zaya.DocumentScanner.Impl.Shared.Views"
        x:Class="Zaya.DocumentScanner.Impl.Shared.Views.MainWindow"
        Title="Zaya Document Scanner"
        Width="900" Height="700">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="12,12,12,8">
            <Button Name="ScanButton" Content="Открыть и распознать..." Click="OnScanClick" />
            <Button Name="SaveDocxButton" Content="Сохранить как DOCX..." Click="OnSaveDocxClick" IsEnabled="False" />
            <Button Name="SettingsButton" Content="Настройки" Click="OnSettingsClick" />
            <TextBlock Name="StatusText" VerticalAlignment="Center" />
        </StackPanel>

        <views:SettingsPanel Name="SettingsPanelControl" DockPanel.Dock="Bottom" IsVisible="False" />

        <TextBox Name="ResultText"
                 Margin="12,0,12,12"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalContentAlignment="Top"
                 FontFamily="Consolas,monospace" />
    </DockPanel>
</Window>
