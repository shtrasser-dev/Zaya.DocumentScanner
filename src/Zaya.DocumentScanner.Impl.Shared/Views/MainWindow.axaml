<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Zaya.DocumentScanner.Impl.Shared.Views.MainWindow"
        Title="Zaya Document Scanner"
        Width="900" Height="700">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <Button Name="ScanButton" Content="Открыть и распознать..." Click="OnScanClick" />
            <TextBlock Name="StatusText" VerticalAlignment="Center" />
        </StackPanel>
        <TextBox Name="ResultText"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalContentAlignment="Top"
                 FontFamily="Consolas,monospace" />
    </DockPanel>
</Window>
