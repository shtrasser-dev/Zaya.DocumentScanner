<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Zaya.DocumentScanner.Impl.Shared.ViewModels"
             xmlns:ui="clr-namespace:Zaya.UI.Impl.Controls;assembly=Zaya.UI.Impl"
             xmlns:ctrl="clr-namespace:Zaya.DocumentScanner.Impl.Shared.Views.Controls"
             x:Class="Zaya.DocumentScanner.Impl.Shared.Views.SettingsPanel"
             x:DataType="vm:SettingsViewModel">
    <UserControl.Styles>
        <!-- Left-side tab strip, same as ScreenTranslator's own settings panel. -->
        <Style Selector="TabItem">
            <Setter Property="Width" Value="{x:Static ctrl:MainLayout.NavWidth}" />
            <Setter Property="MinWidth" Value="{x:Static ctrl:MainLayout.NavWidth}" />
            <Setter Property="MaxWidth" Value="{x:Static ctrl:MainLayout.NavWidth}" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
    </UserControl.Styles>

    <Border Padding="12,8,12,12"
            MaxHeight="420">
        <DockPanel>
            <StackPanel DockPanel.Dock="Bottom"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8"
                        Margin="0,10,0,0">
                <Button Content="Отмена" Command="{Binding CancelCommand}" />
                <Button Content="Сохранить" Command="{Binding SaveCommand}" />
            </StackPanel>

            <TabControl TabStripPlacement="Left">
                <TabItem Header="Сканирование">
                    <ScrollViewer>
                        <ui:SettingDescriptorListControl
                            Descriptors="{Binding DocumentScannerDescriptors}"
                            Values="{Binding DocumentScannerValues}" />
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="OCR">
                    <ScrollViewer>
                        <ui:SettingDescriptorListControl
                            Descriptors="{Binding OcrDescriptors}"
                            Values="{Binding OcrValues}" />
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Разметка текста">
                    <ScrollViewer>
                        <ui:SettingDescriptorListControl
                            Descriptors="{Binding TextLayoutDescriptors}"
                            Values="{Binding TextLayoutValues}" />
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Border>
</UserControl>
