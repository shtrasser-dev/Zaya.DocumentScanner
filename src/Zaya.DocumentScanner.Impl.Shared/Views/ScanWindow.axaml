<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Zaya.DocumentScanner.Impl.Shared.Views"
        x:Class="Zaya.DocumentScanner.Impl.Shared.Views.ScanWindow"
        Title="Распознавание"
        Width="900" Height="700" MinHeight="0"
        SizeToContent="Height">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="12,12,12,8">
            <TextBlock Name="StatusText" VerticalAlignment="Center" />
        </StackPanel>

        <Button Name="SaveDocxButton"
                DockPanel.Dock="Bottom"
                Content="Сохранить как DOCX..."
                Margin="12,8,12,12"
                HorizontalAlignment="Right"
                IsEnabled="False"
                Click="OnSaveDocxClick" />

        <TabControl Name="ResultTabs" Height="480" Margin="12,0,12,12">
            <TabItem Header="Исходный документ">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <views:ScanPreviewCanvas Name="SourceCanvas" HorizontalAlignment="Center" VerticalAlignment="Top" />
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Результат">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ContentControl Name="ResultPreviewHost" HorizontalAlignment="Center" HorizontalContentAlignment="Center" />
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
