<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Zaya.DocumentScanner.Impl.Shared.Views"
        x:Class="Zaya.DocumentScanner.Impl.Shared.Views.ScanWindow"
        Title="Распознавание"
        Width="900" Height="700"
        MinWidth="600" MinHeight="400">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="12,12,12,8">
            <TextBlock Name="StatusText" VerticalAlignment="Center" />
        </StackPanel>

        <Button Name="SaveDocxButton"
                DockPanel.Dock="Bottom"
                Content="Сохранить как DOCX..."
                Margin="12,8,12,12"
                HorizontalAlignment="Right"
                IsEnabled="False"
                Click="OnSaveDocxClick" />

        <!-- No DockPanel.Dock - fills whatever space Top/Bottom siblings leave, and grows/shrinks
             with the window since nothing here caps its height. -->
        <TabControl Name="ResultTabs" Margin="12,0,12,12">
            <TabItem Header="Исходный документ">
                <!-- One source page at a time, with a pager underneath - not all pages stacked in
                     one long scroll. -->
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="8"
                                Margin="0,8,0,0">
                        <Button Name="PrevPageButton" Content="◀" IsEnabled="False" Click="OnPrevPageClick"
                                ToolTip.Tip="Предыдущая страница" />
                        <TextBlock Name="PageIndicator" VerticalAlignment="Center" MinWidth="130" TextAlignment="Center" />
                        <Button Name="NextPageButton" Content="▶" IsEnabled="False" Click="OnNextPageClick"
                                ToolTip.Tip="Следующая страница" />
                    </StackPanel>
                    <ScrollViewer Name="SourceScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ContentControl Name="SourcePageHost" HorizontalAlignment="Center" />
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
            <TabItem Header="Результат">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ContentControl Name="ResultPreviewHost" HorizontalAlignment="Center" HorizontalContentAlignment="Center" />
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
