<Project>
  <PropertyGroup>
    <ZayaPrimitivesVersion>2.0.0</ZayaPrimitivesVersion>
    <ZayaPrimitivesMajor>$([System.Version]::Parse('$(ZayaPrimitivesVersion)').Major)</ZayaPrimitivesMajor>

    <ZayaLoggingVersion>1.0.0</ZayaLoggingVersion>
    <ZayaOcrVersion>2.1.0</ZayaOcrVersion>
    <ZayaUiVersion>2.0.0</ZayaUiVersion>

    <!-- Host app default when ZayaVersionRole is unset. -->
    <ZayaHostVersionMinor>1</ZayaHostVersionMinor>
    <ZayaHostVersionPatch>0</ZayaHostVersionPatch>
  </PropertyGroup>
</Project>
